--- tiltDegrees: 0.00 - 4.00
local tiltDegrees = 2.00

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local player = game.Players.LocalPlayer

local smoothing = 55
local tiltAmount = math.rad(math.clamp(tiltDegrees, 0, 4))

local humanoid, root
local ready = false  -- false while a new character is still loading

local target = 0     -- angle we want (radians)
local current = 0    -- smoothed angle moving toward target
local applied = 0    -- angle already added to the root part's rotation
local wHeld = false

local function bindCharacter(char)
    ready = false
    target, current, applied = 0, 0, 0

    humanoid = char:WaitForChild("Humanoid")
    root = char:WaitForChild("HumanoidRootPart")

    ready = true
end

local function updateTarget()
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Physics then
        target = wHeld and -tiltAmount or 0
    else
        target = 0
    end
end

local function applyTilt(dt)
    current = current + (target - current) * math.clamp(dt * smoothing, 0, 1)

    local delta = current - applied
    if delta ~= 0 then
        root.CFrame = root.CFrame * CFrame.Angles(delta, 0, 0)
        applied = current
    end
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.W then
        wHeld = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.W then
        wHeld = false
    end
end)

RunService.Heartbeat:Connect(function(dt)
    if not ready or not root or not root.Parent then return end
    updateTarget()
    applyTilt(dt)
end)

-- Hook up the current character, then every future one
task.spawn(bindCharacter, player.Character or player.CharacterAdded:Wait())
player.CharacterAdded:Connect(bindCharacter)
